{
  "name": "skilldex",
  "version": "0.1.0",
  "description": "CLI tool that indexes AI agent skills into passive context (AGENTS.md)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "bin": {
    "skilldex": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "keywords": [
    "ai",
    "agents",
    "skills",
    "cli",
    "agents-md",
    "claude",
    "cursor",
    "copilot",
    "passive-context",
    "llm"
  ],
  "author": "Nafis Azizi Riza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nafisazizir/skilldex.git"
  },
  "homepage": "https://github.com/nafisazizir/skilldex#readme",
  "bugs": {
    "url": "https://github.com/nafisazizir/skilldex/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "vitest": "^4.0.18"
  }
}
